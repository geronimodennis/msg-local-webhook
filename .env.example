# Chrome DevTools Protocol URL. Accepts any reachable http(s) CDP endpoint.
BROWSER_CDP_URL=http://127.0.0.1:9222
# Messenger inbox URL.
MESSENGER_URL=https://www.facebook.com/messages
# Accepted values: true (dry run) or false (live sending).
DRY_RUN=true
# Positive number used with IDLE_UNIT.
IDLE_VALUE=5
# Accepted values: seconds or minutes.
IDLE_UNIT=minutes
# Use IDLE_VALUE=10 and IDLE_UNIT=seconds for short testing intervals.
# Positive polling interval in seconds.
POLL_SECONDS=15
# Milliseconds to wait for Messenger's receipt; 0 waits indefinitely.
# Optional regular expression for matching mentions; empty uses the detected account name.
MENTION_PATTERN=
# Comma-separated exact direct-contact names; empty disables direct-contact replies.
DIRECT_CONTACTS=
# Text prefix included in every reply.
REPLY_PREFIX=[DG's AI assistant]:
# Reply body text.
REPLY_TEXT=I’m away right now and will get back to you when I can.
# Accepted values: static or chatbot.
REPLY_MODE=static
# Reply used when chatbot generation fails.
CHATBOT_FALLBACK_TEXT=I’m away right now and will get back to you when I can.
# OpenAI-compatible chat-completions endpoint, for example a local Ollama gateway.
CHATBOT_API_URL=
# Optional bearer token for the chatbot endpoint. Keep secrets only in .env.
CHATBOT_API_KEY=
# Model name accepted by the configured endpoint.
CHATBOT_MODEL=default
# Accepted values: true or false. Enables chatbot lifecycle and tool logs.
CHATBOT_VERBOSE_LOGGING=true
# Accepted values: true or false. Forces one conversation rescan before generating.
CHATBOT_RESCAN_BEFORE_REPLY=false
# Number from 0 to 2; lower values are more deterministic.
CHATBOT_TEMPERATURE=0.4
# Positive number of newest previous conversation messages sent to the chatbot.
CHATBOT_CONTEXT_MESSAGES=1
# Directory for per-message chatbot conversation cache files.
CHATBOT_CACHE_DIRECTORY=.cache
# Maximum characters before the chatbot summarizes and replaces a cache.
CHATBOT_CACHE_MAX_CHARS=12000
# Accepted values: true or false. false writes readable JSON cache files.
CHATBOT_CACHE_COMPRESSION=false
# Directory for readable conversation rescan dumps.
CHATBOT_RESCAN_DUMP_DIRECTORY=.cache/rescans
# System instruction sent to the chatbot.
CHATBOT_SYSTEM_PROMPT="You are DG's AI assistant.

Your role:
Reply to the current Messenger message in a helpful, concise, and natural way.

Context:
Use the previous conversation context, the current incoming message, and the sender information provided.
If the previous context is incomplete or does not answer the user, use the rescan_conversation tool before replying.
Do not claim that earlier conversation is unavailable until you have attempted a conversation rescan.
Do not invent missing facts or claim to be human.

Response style:
Use natural conversational text.
Emojis and normal Messenger formatting are allowed.
Do not use Markdown syntax, Markdown headings, Markdown bullets, code blocks, or Markdown links."
# CSS selector for rendered Messenger message elements.
MESSAGE_SELECTOR=[data-message-id]
# CSS selector for the Messenger composer.
COMPOSER_SELECTOR=textarea, [contenteditable="true"]
