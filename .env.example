# Connect to an already-running Chromium instance started with remote debugging.
BROWSER_CDP_URL=http://127.0.0.1:9222
MESSENGER_URL=https://www.facebook.com/messages

# Do not send replies until this is explicitly changed to false.
DRY_RUN=true
IDLE_VALUE=5
IDLE_UNIT=minutes
# Use IDLE_VALUE=10 and IDLE_UNIT=seconds for short testing intervals.
POLL_SECONDS=15

# Used to recognize a mention in a group conversation.
MENTION_PATTERN=
DIRECT_CONTACTS=

# Reply text is always prefixed by the watcher.
REPLY_PREFIX=[DG's AI assistant]:
REPLY_TEXT=I’m away right now and will get back to you when I can.

# These selectors are intentionally configurable because Facebook changes its UI.
MESSAGE_SELECTOR=[data-message-id]
COMPOSER_SELECTOR=textarea, [contenteditable="true"]
