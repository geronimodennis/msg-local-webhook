# Chrome DevTools Protocol URL. Accepts any reachable http(s) CDP endpoint.
BROWSER_CDP_URL=http://127.0.0.1:9222
# Messenger inbox URL.
MESSENGER_URL=https://www.facebook.com/messages
# Accepted values: true (dry run) or false (live sending).
DRY_RUN=true
# Positive number used with IDLE_UNIT.
IDLE_VALUE=5
# Accepted values: seconds or minutes.
IDLE_UNIT=minutes
# Use IDLE_VALUE=10 and IDLE_UNIT=seconds for short testing intervals.
# Positive polling interval in seconds.
POLL_SECONDS=15
# Optional regular expression for matching mentions; empty uses the detected account name.
MENTION_PATTERN=
# Comma-separated exact direct-contact names; empty disables direct-contact replies.
DIRECT_CONTACTS=
# Text prefix included in every reply.
REPLY_PREFIX=[DG's AI assistant]:
# Reply body text.
REPLY_TEXT=I’m away right now and will get back to you when I can.
# CSS selector for rendered Messenger message elements.
MESSAGE_SELECTOR=[data-message-id]
# CSS selector for the Messenger composer.
COMPOSER_SELECTOR=textarea, [contenteditable="true"]
